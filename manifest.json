{
  "manifest_version": 3,
  "name": "休息提醒 · Break Bell",
  "version": "1.2.0",
  "description": "在设定的工作时段提醒你规律休息。",
  "minimum_chrome_version": "116",
  "permissions": ["alarms", "storage", "notifications", "idle", "offscreen", "windows"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "休息提醒", "default_popup": "popup.html" },
  "options_page": "options.html"
}
